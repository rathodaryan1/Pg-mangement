# ==============================================================================
# URBAN NEST — BACKEND (RENDER / RAILWAY / NODE) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Connection Pooler URL (Session/Transaction mode on port 6543) for application queries
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public

# Direct Database URL (Direct connection on port 5432) for Prisma schema migrations
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key (e.g. generate via: openssl rand -base64 32)
JWT_SECRET=your_super_secret_production_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAIN
# ------------------------------------------------------------------------------
# Primary Vercel domain or custom domain (e.g. https://urbannest.vercel.app)
# Multiple comma-separated domains are supported.
FRONTEND_URL=https://your-app-name.vercel.app

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (SECURE DOCUMENT VAULT)
# ------------------------------------------------------------------------------
# Kept strictly on the backend. Never expose service role key to frontend.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=resident-documents

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY & WEBHOOKS (PRODUCTION)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. OPTIONAL: WHATSAPP BSP OUTBOUND DISPATCH (LIVE PRODUCTION)
# ------------------------------------------------------------------------------
# In the absence of live BSP credentials, system runs safely in mock/sandbox mode.
# Option A: Twilio for WhatsApp
# TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Gupshup Enterprise WhatsApp
# GUPSHUP_APP_NAME=your_gupshup_app_name
# GUPSHUP_API_KEY=your_gupshup_api_key

# Option C: Meta Cloud API for WhatsApp
# WHATSAPP_API_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# ------------------------------------------------------------------------------
# 7. OPTIONAL: STATUTORY E-SIGN GATEWAY (AADHAAR E-SIGN / DIGIO / LEEGILITY)
# ------------------------------------------------------------------------------
# ESIGN_SERVICE_URL=https://ext.digio.in
# ESIGN_CLIENT_ID=your_esign_client_id
# ESIGN_CLIENT_SECRET=your_esign_client_secret

