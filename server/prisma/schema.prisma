datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 0. MULTI-TENANT SAAS PLATFORM: Tenant & Subscription
// -------------------------------------------------------------
enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Tenant {
  id                    String             @id @default(uuid())
  name                  String             // e.g. "Green Valley PG Group"
  slug                  String             @unique // e.g. "green-valley-pg"
  email                 String             @unique
  phone                 String?
  address               String?
  city                  String?            @default("Ahmedabad")
  state                 String?            @default("Gujarat")
  country               String             @default("India")
  status                TenantStatus       @default(TRIAL)
  plan                  SubscriptionPlan   @default(TRIAL)
  subscriptionStatus    SubscriptionStatus @default(TRIALING)
  trialEndsAt           DateTime?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  maxProperties         Int                @default(1)
  maxRooms              Int                @default(20)
  maxResidents          Int                @default(50)
  users                 User[]
  properties            Property[]
  auditLogs             AuditLog[]
  supportTickets        SupportTicket[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([slug])
  @@index([status])
  @@index([plan])
}

model Plan {
  id            String           @id @default(uuid())
  name          String           @unique // "Starter", "Professional", "Enterprise"
  tier          SubscriptionPlan @unique
  priceMonthly  Float
  priceYearly   Float
  maxProperties Int
  maxRooms      Int
  maxResidents  Int
  features      String           // JSON string of enabled features
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// -------------------------------------------------------------
// 1. USER & AUTHENTICATION
// -------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  MAINTENANCE
  RESIDENT
  COOK
  SECURITY_GUARD
  HOUSEKEEPING
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(RESIDENT)
  mobile       String?
  avatarUrl    String?
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?      @relation(fields: [propertyId], references: [id])
  resident     Resident?
  notifications Notification[]
  auditLogs    AuditLog[]     @relation("ActorAuditLogs")
  staffAttendances StaffAttendance[]
  staffAdvances    StaffAdvance[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@index([tenantId])
}

// -------------------------------------------------------------
// 2. PROPERTY STRUCTURE: Property -> Building -> Floor -> Room -> Bed
// -------------------------------------------------------------
model Property {
  id                String            @id @default(uuid())
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  address           String
  city              String            @default("Ahmedabad")
  phone             String?
  email             String?
  upiId             String?
  gstNumber         String?
  razorpayKeyId     String?
  razorpayKeySecret String?
  buildings         Building[]
  rooms             Room[]
  residents         Resident[]
  staff             User[]
  agreements        Agreement[]
  securityDeposits  SecurityDeposit[]
  payments          Payment[]
  visitorRequests   VisitorRequest[]
  complaints        Complaint[]
  leaveRequests     LeaveRequest[]
  documents         Document[]
  notices           Notice[]
  sosEvents         SOSEvent[]
  expenses          Expense[]
  inventoryItems    InventoryItem[]
  tasks             OperationalTask[]
  menus             Menu[]
  kitchenIngredients KitchenIngredient[]
  purchaseRequests  PurchaseRequest[]
  leads             Lead[]
  bookings          Booking[]
  housekeepingTasks HousekeepingTask[]
  utilityReadings   UtilityReading[]
  auditLogs         AuditLog[]
  moveInChecklists  MoveInChecklist[]
  moveOutSettlements MoveOutSettlement[]
  parcels           Parcel[]
  assets            Asset[]
  vendors           Vendor[]
  staffAttendances  StaffAttendance[]
  staffAdvances     StaffAdvance[]
  complianceRecords ComplianceRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Building {
  id         String   @id @default(uuid())
  name       String   // e.g. "Block A", "Main Wing"
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors     Floor[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Floor {
  id          String   @id @default(uuid())
  floorNumber Int      // 1, 2, 3...
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
}

model Room {
  id         String     @id @default(uuid())
  number     String     // e.g. "101", "202"
  type       String     // Single, Double, Triple, Four-sharing
  capacity   Int
  baseRent   Float
  deposit    Float
  status     RoomStatus @default(AVAILABLE)
  amenities  String     // Comma-separated: "AC, High-Speed Wi-Fi, Attached Bath"
  floorId    String?
  floor      Floor?     @relation(fields: [floorId], references: [id], onDelete: SetNull)
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds       Bed[]
  complaints Complaint[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([number, propertyId])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Bed {
  id          String    @id @default(uuid())
  bedNumber   String    // e.g. "Bed A", "Bed B"
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status      BedStatus @default(AVAILABLE)
  monthlyRent Float
  resident    Resident?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([bedNumber, roomId])
}

// -------------------------------------------------------------
// 3. RESIDENT PROFILE & LIFECYCLE
// -------------------------------------------------------------
enum ResidentStatus {
  PENDING_MOVE_IN
  ACTIVE
  NOTICE_PERIOD
  MOVED_OUT
  INACTIVE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
}

model Resident {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId               String
  property                 Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bedId                    String?           @unique
  bed                      Bed?              @relation(fields: [bedId], references: [id], onDelete: SetNull)
  fullName                 String
  email                    String
  mobile                   String
  alternateMobile          String?
  gender                   String?           // MALE, FEMALE, OTHER
  emergencyContactName     String
  emergencyContactRelation String
  emergencyContactPhone    String
  kycStatus                KycStatus         @default(PENDING)
  kycDocumentType          KycDocumentType   @default(AADHAAR)
  kycDocumentNumber        String?
  joiningDate              DateTime          @default(now())
  expectedMoveOutDate      DateTime?
  status                   ResidentStatus    @default(ACTIVE)
  permanentAddress         String?
  workCompany              String?
  agreements               Agreement[]
  securityDeposits         SecurityDeposit[]
  payments                 Payment[]
  visitorRequests          VisitorRequest[]
  complaints               Complaint[]
  leaveRequests            LeaveRequest[]
  documents                Document[]
  notifications            Notification[]
  sosEvents                SOSEvent[]
  mealParticipations       MealParticipation[]
  moveInChecklist          MoveInChecklist?
  moveOutSettlement        MoveOutSettlement?
  parcels                  Parcel[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([propertyId])
  @@index([status])
}

// -------------------------------------------------------------
// 4. LEASE AGREEMENT & SECURITY DEPOSIT
// -------------------------------------------------------------
enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model Agreement {
  id              String          @id @default(uuid())
  residentId      String
  resident        Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agreementNumber String          @unique
  validFrom       DateTime
  validTill       DateTime
  signedUrl       String?
  status          AgreementStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

model SecurityDeposit {
  id           String        @id @default(uuid())
  residentId   String
  resident     Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount       Float
  status       DepositStatus @default(PENDING)
  paidAt       DateTime?
  refundAmount Float?
  deductions   Float?        @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// -------------------------------------------------------------
// 5. FINANCE & PAYMENTS
// -------------------------------------------------------------
enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  APPROVAL_PENDING
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  NET_BANKING
  CARD
  RAZORPAY
}

enum ChargeCategory {
  RENT
  SECURITY_DEPOSIT
  ELECTRICITY
  FOOD
  MAINTENANCE_FEE
  LATE_FINE
  OTHER
}

model Payment {
  id            String          @id @default(uuid())
  residentId    String
  resident      Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount        Float
  category      ChargeCategory  @default(RENT)
  period        String          // e.g. "September 2026"
  dueDate       DateTime
  paidDate      DateTime?
  status        PaymentStatus   @default(PENDING)
  method        PaymentMethod?
  transactionId String?
  orderId       String?         // Razorpay Order ID
  receipt       PaymentReceipt?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([residentId])
  @@index([propertyId])
  @@index([status])
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receiptNumber String   @unique
  generatedAt   DateTime @default(now())
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// 6. VISITOR PASS & GATE SECURITY
// -------------------------------------------------------------
enum VisitorStatus {
  PENDING
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

model VisitorRequest {
  id                String        @id @default(uuid())
  residentId        String?
  resident          Resident?      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorName       String
  visitorMobile     String
  relation          String
  purpose           String
  visitDate         DateTime
  expectedEntryTime String        // e.g. "04:00 PM"
  expectedExitTime  String?       // e.g. "08:00 PM"
  status            VisitorStatus @default(PENDING)
  approvedBy        String?
  qrPassToken       String        @unique @default(uuid())
  checkInTime       DateTime?
  checkOutTime      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([residentId])
  @@index([propertyId])
  @@index([status])
}

// -------------------------------------------------------------
// 7. COMPLAINTS & MAINTENANCE
// -------------------------------------------------------------
enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  AIR_CONDITIONING
  WIFI_INTERNET
  CLEANING
  CARPENTRY
  PEST_CONTROL
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model Complaint {
  id            String                @id @default(uuid())
  ticketNumber  String                @unique
  residentId    String
  resident      Resident              @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title         String
  description   String
  category      ComplaintCategory     @default(OTHER)
  priority      ComplaintPriority     @default(MEDIUM)
  status        ComplaintStatus       @default(REPORTED)
  assignedStaff String?
  resolvedAt    DateTime?
  rating        Int?
  feedback      String?
  activities    MaintenanceActivity[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([residentId])
  @@index([propertyId])
  @@index([status])
}

model MaintenanceActivity {
  id          String          @id @default(uuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      ComplaintStatus
  updatedBy   String
  comment     String
  timestamp   DateTime        @default(now())
}

// -------------------------------------------------------------
// 8. LEAVE REQUESTS
// -------------------------------------------------------------
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(uuid())
  residentId String
  resident   Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  appliedAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([residentId])
  @@index([propertyId])
}

// -------------------------------------------------------------
// 9. DOCUMENTS (KYC, AGREEMENTS, PROOFS)
// -------------------------------------------------------------
enum DocumentType {
  AADHAAR
  PAN
  AGREEMENT
  POLICE_VERIFICATION
  RECEIPT
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Document {
  id              String         @id @default(uuid())
  residentId      String
  resident        Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String
  type            DocumentType   @default(OTHER)
  fileUrl         String
  fileSize        Int?           // In Bytes
  mimeType        String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([residentId])
  @@index([propertyId])
}

// -------------------------------------------------------------
// 10. NOTICES & NOTIFICATIONS
// -------------------------------------------------------------
enum NoticeCategory {
  GENERAL
  MAINTENANCE
  PAYMENT
  EMERGENCY
  EVENT
  RULES
}

model Notice {
  id            String         @id @default(uuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title         String
  content       String
  category      NoticeCategory @default(GENERAL)
  isImportant   Boolean        @default(false)
  publishedAt   DateTime       @default(now())
  expiresAt     DateTime?
  publisherName String         @default("Urban Nest Management")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String    @default("INFO") // PAYMENT, VISITOR, COMPLAINT, LEAVE, NOTICE, SOS
  isRead     Boolean   @default(false)
  linkUrl    String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

// -------------------------------------------------------------
// 11. EMERGENCY SOS EVENTS
// -------------------------------------------------------------
enum SOSStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model SOSEvent {
  id             String    @id @default(uuid())
  residentId     String
  resident       Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status         SOSStatus @default(ACTIVE)
  triggeredAt    DateTime  @default(now())
  acknowledgedBy String?
  resolvedAt     DateTime?
  notes          String?

  @@index([residentId])
  @@index([propertyId])
}

// -------------------------------------------------------------
// 12. AUDIT TRAIL LOGS
// -------------------------------------------------------------
model AuditLog {
  id         String    @id @default(uuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorRole  String
  action     String    // LOGIN, PROFILE_UPDATE, TICKET_CREATED, PAYMENT_INITIATED, SOS_TRIGGERED, etc.
  entity     String    // User, Resident, Payment, Complaint, VisitorRequest, etc.
  entityId   String?
  timestamp  DateTime  @default(now())
  ipAddress  String?
  details    String

  @@index([tenantId])
  @@index([propertyId])
  @@index([timestamp])
}

// -------------------------------------------------------------
// 13. SYSTEM SETTINGS
// -------------------------------------------------------------
model Setting {
  key   String @id
  value String
}

// -------------------------------------------------------------
// 14. EXPENSES (PROPERTY-SCOPED)
// -------------------------------------------------------------
enum ExpenseCategory {
  ELECTRICITY
  WATER
  MAINTENANCE
  SALARY
  INTERNET
  SUPPLIES
  FOOD
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Float
  vendor      String?
  date        DateTime        @default(now())
  receiptUrl  String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([propertyId])
  @@index([date])
}

// -------------------------------------------------------------
// 15. INVENTORY & ASSETS TRACKING
// -------------------------------------------------------------
enum AssetCondition {
  EXCELLENT
  GOOD
  NEEDS_REPAIR
  REPLACED
  LOW_STOCK
}

model InventoryItem {
  id             String         @id @default(uuid())
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  category       String         // e.g. "Furniture", "Electronics", "Appliance", "Plumbing"
  quantity       Int            @default(1)
  minQuantity    Int            @default(2)
  status         AssetCondition @default(GOOD)
  location       String?        // e.g. "Room 101", "Common Lounge", "Basement"
  purchaseDate   DateTime?
  vendor         String?
  cost           Float?
  warrantyExpiry DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([propertyId])
}

// -------------------------------------------------------------
// 16. OPERATIONAL TASKS & HOUSEKEEPING
// -------------------------------------------------------------
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model OperationalTask {
  id          String       @id @default(uuid())
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  category    String       // "CLEANING", "INSPECTION", "MAINTENANCE", "RENT_COLLECTION"
  priority    TaskPriority @default(MEDIUM)
  assignedTo  String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDING)
  notes       String?
  sourceType  String?      // "COMPLAINT", "INSPECTION", "HOUSEKEEPING", "PREVENTIVE_MAINTENANCE", "MANUAL"
  sourceId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([propertyId])
}

// -------------------------------------------------------------
// 17. PLATFORM SUPPORT TICKETS
// -------------------------------------------------------------
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id            String         @id @default(uuid())
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creatorEmail  String
  creatorName   String?
  subject       String
  description   String
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  assignedAdmin String?
  internalNotes String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([status])
}

// -------------------------------------------------------------
// 18. KITCHEN, MEAL PLANNING & PARTICIPATION
// -------------------------------------------------------------
enum MealPeriod {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum DietaryType {
  VEG
  NON_VEG
  JAIN
  VEGAN
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum MealParticipationStatus {
  OPTED_IN
  OPTED_OUT
}

model Menu {
  id             String              @id @default(uuid())
  propertyId     String
  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date           DateTime
  mealPeriod     MealPeriod
  title          String              // e.g. "Sunday Royal Lunch"
  status         MenuStatus          @default(DRAFT)
  servingTime    String?             // e.g. "12:30 PM - 02:30 PM"
  cutoffTime     String?             // e.g. "10:00 AM"
  notes          String?
  items          MenuItem[]
  participations MealParticipation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([propertyId, date, mealPeriod])
  @@index([propertyId])
  @@index([date])
}

model MenuItem {
  id          String      @id @default(uuid())
  menuId      String
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dietaryType DietaryType @default(VEG)
  allergens   String?
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([menuId])
}

model MealParticipation {
  id         String                  @id @default(uuid())
  menuId     String
  menu       Menu                    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident                @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId String
  status     MealParticipationStatus @default(OPTED_IN)
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([menuId, residentId])
  @@index([residentId])
  @@index([propertyId])
}

model KitchenIngredient {
  id           String            @id @default(uuid())
  propertyId   String
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  category     String            // Grains, Vegetables, Dairy, Spices, Oil
  currentStock Float             @default(0)
  minStock     Float             @default(5)
  unit         String            // kg, liters, packets, units
  costPerUnit  Float?
  supplier     String?
  movements    KitchenMovement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([propertyId])
}

enum KitchenMovementType {
  STOCK_IN
  CONSUMED
  WASTED
}

model KitchenMovement {
  id           String              @id @default(uuid())
  ingredientId String
  ingredient   KitchenIngredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  propertyId   String
  type         KitchenMovementType
  quantity     Float
  reason       String?
  recordedBy   String?
  timestamp    DateTime            @default(now())

  @@index([ingredientId])
  @@index([propertyId])
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
}

model PurchaseRequest {
  id            String                @id @default(uuid())
  propertyId    String
  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  itemTitle     String
  quantity      Float
  unit          String
  estimatedCost Float?
  status        PurchaseRequestStatus @default(PENDING)
  requestedBy   String
  approvedBy    String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([propertyId])
}

// -------------------------------------------------------------
// 19. LEADS, ADMISSIONS & BOOKINGS
// -------------------------------------------------------------
enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  APPLIED
  CONVERTED
  LOST
}

model Lead {
  id                 String     @id @default(uuid())
  tenantId           String
  propertyId         String
  property           Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name               String
  email              String
  phone              String
  roomTypePreference String?
  source             String     @default("WEBSITE")
  status             LeadStatus @default(NEW)
  visitDate          DateTime?
  followUpDate       DateTime?
  notes              String?
  referrerName       String?
  referrerPhone      String?
  referralCommission Float?     @default(0)
  commissionStatus   String?    @default("PENDING")
  whatsappConsent    Boolean    @default(false)
  whatsappOptOut     Boolean    @default(false)
  lastWhatsappSentAt DateTime?
  assignedTo         String?
  booking            Booking?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id            String        @id @default(uuid())
  tenantId      String
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId        String?       @unique
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String
  roomId        String?
  bedId         String?
  depositAmount Float         @default(0)
  isDepositPaid Boolean       @default(false)
  status        BookingStatus @default(PENDING)
  checkInDate   DateTime
  token         String        @unique @default(uuid())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

// -------------------------------------------------------------
// 20. HOUSEKEEPING TASKS & SCHEDULES
// -------------------------------------------------------------
enum HousekeepingArea {
  ROOM
  BATHROOM
  CORRIDOR
  KITCHEN
  DINING
  LOBBY
  TERRACE
}

model HousekeepingTask {
  id          String           @id @default(uuid())
  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  area        HousekeepingArea @default(ROOM)
  targetName  String
  assignedTo  String?
  scheduledAt DateTime
  completedAt DateTime?
  verifiedBy  String?
  status      TaskStatus       @default(PENDING)
  checklist   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([propertyId])
  @@index([status])
}

// -------------------------------------------------------------
// 21. UTILITY READINGS & IOT MONITORING
// -------------------------------------------------------------
enum UtilityType {
  ELECTRICITY
  WATER
  GAS
  INTERNET
}

model UtilityReading {
  id              String      @id @default(uuid())
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type            UtilityType @default(ELECTRICITY)
  meterNumber     String
  previousReading Float
  currentReading  Float
  unitsConsumed   Float
  unitRate        Float
  totalAmount     Float
  billingPeriod   String
  readingDate     DateTime    @default(now())
  recordedBy      String
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([propertyId])
  @@index([type])
}

// -------------------------------------------------------------
// 22. AI BUSINESS ASSISTANT AUDIT LOG
// -------------------------------------------------------------
model AIAssistantLog {
  id           String   @id @default(uuid())
  tenantId     String
  propertyId   String?
  userId       String
  query        String
  response     String
  toolsInvoked String?
  timestamp    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

// -------------------------------------------------------------
// 23. RESIDENT LIFECYCLE: MOVE-IN CHECKLIST & SETTLEMENT
// -------------------------------------------------------------
model MoveInChecklist {
  id               String   @id @default(uuid())
  residentId       String   @unique
  resident         Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  keyHandedOver    Boolean  @default(false)
  roomInspected    Boolean  @default(false)
  bedPrepared      Boolean  @default(false)
  acRemoteGiven    Boolean  @default(false)
  rulesAccepted    Boolean  @default(false)
  checklistItems   String?  // JSON string of custom items
  inspectedBy      String?
  residentSignedAt DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertyId])
}

model MoveOutSettlement {
  id                String   @id @default(uuid())
  residentId        String   @unique
  resident          Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  noticeDate        DateTime
  moveOutDate       DateTime
  inspectionStatus  String   @default("PENDING") // PENDING, PASSED, DAMAGED
  inspectionNotes   String?
  depositHeld       Float
  unpaidRent        Float    @default(0)
  damageDeductions  Float    @default(0)
  utilityDeductions Float    @default(0)
  otherDeductions   Float    @default(0)
  netRefundAmount   Float
  refundStatus      String   @default("PENDING") // PENDING, PROCESSED, COMPLETED
  settledBy         String?
  settledAt         DateTime?
  bedReleased       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertyId])
}

// -------------------------------------------------------------
// 24. PARCEL & COURIER MANAGEMENT
// -------------------------------------------------------------
enum ParcelStatus {
  RECEIVED
  NOTIFIED
  COLLECTED
  RETURNED
}

model Parcel {
  id              String       @id @default(uuid())
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residentId      String?
  resident        Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  recipientName   String
  recipientRoom   String?
  courierCompany  String       // Amazon, Flipkart, Swiggy, BlueDart, DTDC, India Post
  trackingNumber  String?
  pickupPin       String       // 4-digit verification code or QR token
  status          ParcelStatus @default(RECEIVED)
  receivedAt      DateTime     @default(now())
  collectedAt     DateTime?
  collectedBy     String?
  receivedByGuard String?
  notes           String?

  @@index([propertyId])
  @@index([residentId])
  @@index([status])
}

// -------------------------------------------------------------
// 25. ASSET REGISTER & PREVENTIVE MAINTENANCE
// -------------------------------------------------------------
enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  DECOMMISSIONED
  REPLACED
}

model Asset {
  id                  String      @id @default(uuid())
  propertyId          String
  property            Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name                String      // e.g. "Voltas 1.5T Inverter AC - Room 204"
  category            String      // AC, RO_WATER, WATER_PUMP, GENERATOR, LIFT, GEYSER, REFRIGERATOR, WASHING_MACHINE
  serialNumber        String?
  location            String      // "Room 204", "Rooftop Terrace", "Basement Utility Room"
  purchaseDate        DateTime?
  warrantyExpiry      DateTime?
  vendorName          String?
  vendorContact       String?
  status              AssetStatus @default(OPERATIONAL)
  lastServicedAt      DateTime?
  nextServiceDue      DateTime?
  serviceIntervalDays Int         @default(90) // Quarterly default
  qrTag               String      @unique @default(uuid())
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([propertyId])
  @@index([category])
  @@index([status])
}

// -------------------------------------------------------------
// 26. VENDOR & PROCUREMENT DIRECTORY
// -------------------------------------------------------------
model Vendor {
  id             String   @id @default(uuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String   // e.g. "Ahmedabad Fresh Vegetables & Dairy"
  category       String   // GROCERY, PLUMBING, ELECTRICAL, SECURITY, INTERNET, REPAIRS
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  gstNumber      String?
  rating         Float?   @default(5.0)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([propertyId])
  @@index([category])
}

// -------------------------------------------------------------
// 27. WORKFORCE: SHIFTS, ATTENDANCE & SALARY ADVANCES
// -------------------------------------------------------------
model StaffAttendance {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  status       String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@index([propertyId])
  @@index([userId])
}

model StaffAdvance {
  id          String    @id @default(uuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  disbursedAt DateTime  @default(now())
  monthYear   String    // e.g. "October 2026"
  isDeducted  Boolean   @default(false)
  deductedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([monthYear])
}

// -------------------------------------------------------------
// 28. STATUTORY COMPLIANCE & SAFETY AUDIT
// -------------------------------------------------------------
model ComplianceRecord {
  id                String    @id @default(uuid())
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category          String    // FIRE_SAFETY, LIFT_FITNESS, PEST_CONTROL, HEALTH_NOC, POLICE_INTIMATION, CCTV_AUDIT
  title             String
  issuingAuthority  String?
  certificateNumber String?
  validFrom         DateTime?
  validTill         DateTime?
  status            String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, PENDING_RENEWAL
  documentUrl       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([propertyId])
  @@index([category])
  @@index([status])
}

// -------------------------------------------------------------
// 29. AGREEMENT TEMPLATES
// -------------------------------------------------------------
model AgreementTemplate {
  id         String   @id @default(uuid())
  propertyId String?
  title      String   @default("Standard Co-Living Tenancy Agreement")
  content    String   // markdown / html with {{variable}} interpolation tags
  version    Int      @default(1)
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId])
}




