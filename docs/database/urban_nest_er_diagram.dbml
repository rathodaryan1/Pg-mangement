  updatedAt                  timestamp          [not null]

  indexes {
    (bedNumber, roomId) [unique]
  }
}

Table Resident {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  userId                     varchar            [unique, not null]
  propertyId                 varchar            [not null]
  bedId                      varchar            [unique]
  fullName                   varchar            [not null]
  email                      varchar            [not null]
  mobile                     varchar            [not null]
  alternateMobile            varchar           
  gender                     varchar           
  emergencyContactName       varchar            [not null]
  emergencyContactRelation   varchar            [not null]
  emergencyContactPhone      varchar            [not null]
  kycStatus                  KycStatus          [not null, default: 'PENDING']
  kycDocumentType            KycDocumentType    [not null, default: 'AADHAAR']
  kycDocumentNumber          varchar           
  joiningDate                timestamp          [not null, default: `now()`]
  expectedMoveOutDate        timestamp         
  status                     ResidentStatus     [not null, default: 'ACTIVE']
  permanentAddress           varchar           
  workCompany                varchar           
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
    (propertyId)
    (status)
  }
}

Table Agreement {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  residentId                 varchar            [not null]
  propertyId                 varchar            [not null]
