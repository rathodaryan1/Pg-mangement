    (propertyId)
    (status)
  }
}

Table Complaint {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  ticketNumber               varchar            [unique, not null]
  residentId                 varchar            [not null]
  propertyId                 varchar            [not null]
  roomId                     varchar           
  title                      varchar            [not null]
  description                varchar            [not null]
  category                   ComplaintCategory  [not null, default: 'OTHER']
  priority                   ComplaintPriority  [not null, default: 'MEDIUM']
  status                     ComplaintStatus    [not null, default: 'REPORTED']
  assignedStaff              varchar           
