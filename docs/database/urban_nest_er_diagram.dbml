}

TableGroup safety_emergency {
  SOSEvent
}

TableGroup compliance_settings {
  AuditLog
  Setting
}

TableGroup operations_inventory {
  InventoryItem
  OperationalTask
}

TableGroup platform_support {
  SupportTicket
}

// ------------------------------------------------------------------------------
// FOREIGN KEY RELATIONSHIPS (40 Explicit Foreign Keys)
// ------------------------------------------------------------------------------
Ref: User.tenantId > Tenant.id [delete: cascade]
Ref: User.propertyId > Property.id
Ref: Property.tenantId > Tenant.id [delete: cascade]
Ref: Building.propertyId > Property.id [delete: cascade]
Ref: Floor.buildingId > Building.id [delete: cascade]
Ref: Room.floorId > Floor.id [delete: set null]
Ref: Room.propertyId > Property.id [delete: cascade]
Ref: Bed.roomId > Room.id [delete: cascade]
Ref: Resident.userId - User.id [delete: cascade]
Ref: Resident.propertyId > Property.id [delete: cascade]
Ref: Resident.bedId - Bed.id [delete: set null]
Ref: Agreement.residentId > Resident.id [delete: cascade]
Ref: Agreement.propertyId > Property.id [delete: cascade]
Ref: SecurityDeposit.residentId > Resident.id [delete: cascade]
Ref: SecurityDeposit.propertyId > Property.id [delete: cascade]
Ref: Payment.residentId > Resident.id [delete: cascade]
Ref: Payment.propertyId > Property.id [delete: cascade]
Ref: PaymentReceipt.paymentId - Payment.id [delete: cascade]
Ref: VisitorRequest.residentId > Resident.id [delete: cascade]
Ref: VisitorRequest.propertyId > Property.id [delete: cascade]
Ref: Complaint.residentId > Resident.id [delete: cascade]
Ref: Complaint.propertyId > Property.id [delete: cascade]
Ref: Complaint.roomId > Room.id [delete: set null]
Ref: MaintenanceActivity.complaintId > Complaint.id [delete: cascade]
Ref: LeaveRequest.residentId > Resident.id [delete: cascade]
Ref: LeaveRequest.propertyId > Property.id [delete: cascade]
Ref: Document.residentId > Resident.id [delete: cascade]
Ref: Document.propertyId > Property.id [delete: cascade]
Ref: Notice.propertyId > Property.id [delete: cascade]
Ref: Notification.userId > User.id [delete: cascade]
Ref: Notification.residentId > Resident.id [delete: cascade]
Ref: SOSEvent.residentId > Resident.id [delete: cascade]
Ref: SOSEvent.propertyId > Property.id [delete: cascade]
Ref: AuditLog.tenantId > Tenant.id [delete: set null]
Ref: AuditLog.propertyId > Property.id [delete: set null]
Ref: AuditLog.actorId > User.id [delete: set null]
Ref: Expense.propertyId > Property.id [delete: cascade]
Ref: InventoryItem.propertyId > Property.id [delete: cascade]
Ref: OperationalTask.propertyId > Property.id [delete: cascade]
Ref: SupportTicket.tenantId > Tenant.id [delete: cascade]
