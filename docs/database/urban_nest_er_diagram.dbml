Table Tenant {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  name                       varchar            [not null]
  slug                       varchar            [unique, not null]
  email                      varchar            [unique, not null]
  phone                      varchar           
  address                    varchar           
  city                       varchar            [default: 'Ahmedabad']
  state                      varchar            [default: 'Gujarat']
  country                    varchar            [not null, default: 'India']
  status                     TenantStatus       [not null, default: 'TRIAL']
  plan                       SubscriptionPlan   [not null, default: 'TRIAL']
  subscriptionStatus         SubscriptionStatus [not null, default: 'TRIALING']
  trialEndsAt                timestamp         
  subscriptionStartedAt      timestamp         
  subscriptionEndsAt         timestamp         
  maxProperties              integer            [not null, default: 1]
  maxRooms                   integer            [not null, default: 20]
  maxResidents               integer            [not null, default: 50]
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
    (slug)
    (status)
    (plan)
  }
}

Table Plan {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  name                       varchar            [unique, not null]
  tier                       SubscriptionPlan   [unique, not null]
  priceMonthly               decimal            [not null]
  priceYearly                decimal            [not null]
  maxProperties              integer            [not null]
  maxRooms                   integer            [not null]
  maxResidents               integer            [not null]
  features                   varchar            [not null]
  isActive                   boolean            [not null, default: true]
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]
}

Table User {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  email                      varchar            [unique, not null]
  passwordHash               varchar            [not null]
  name                       varchar            [not null]
  role                       UserRole           [not null, default: 'RESIDENT']
  mobile                     varchar           
  avatarUrl                  varchar           
  tenantId                   varchar           
  propertyId                 varchar           
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
    (email)
    (role)
    (tenantId)
  }
}

Table Property {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  tenantId                   varchar           
  name                       varchar            [not null]
  address                    varchar            [not null]
  city                       varchar            [not null, default: 'Ahmedabad']
  phone                      varchar           
  email                      varchar           
  upiId                      varchar           
  gstNumber                  varchar           
  razorpayKeyId              varchar           
  razorpayKeySecret          varchar           
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]
}

Table Building {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  name                       varchar            [not null]
  propertyId                 varchar            [not null]
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]
}

