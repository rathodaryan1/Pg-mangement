  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]
}

Table SecurityDeposit {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  residentId                 varchar            [not null]
  propertyId                 varchar            [not null]
  amount                     decimal            [not null]
  status                     DepositStatus      [not null, default: 'PENDING']
  paidAt                     timestamp         
  refundAmount               decimal           
  deductions                 decimal            [default: 0]
  notes                      varchar           
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]
}

Table Payment {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  residentId                 varchar            [not null]
  propertyId                 varchar            [not null]
  amount                     decimal            [not null]
  category                   ChargeCategory     [not null, default: 'RENT']
  period                     varchar            [not null]
  dueDate                    timestamp          [not null]
  paidDate                   timestamp         
  status                     PaymentStatus      [not null, default: 'PENDING']
  method                     PaymentMethod     
  transactionId              varchar           
  orderId                    varchar           
  notes                      varchar           
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
    (residentId)
    (propertyId)
    (status)
  }
}

Table PaymentReceipt {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  paymentId                  varchar            [unique, not null]
  receiptNumber              varchar            [unique, not null]
