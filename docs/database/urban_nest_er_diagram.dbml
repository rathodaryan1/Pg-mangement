  updatedAt                  timestamp          [not null]
}

Table Room {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  number                     varchar            [not null]
  type                       varchar            [not null]
  capacity                   integer            [not null]
  baseRent                   decimal            [not null]
  deposit                    decimal            [not null]
  status                     RoomStatus         [not null, default: 'AVAILABLE']
  amenities                  varchar            [not null]
  floorId                    varchar           
  propertyId                 varchar            [not null]
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
    (number, propertyId) [unique]
  }
}

Table Bed {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  bedNumber                  varchar            [not null]
  roomId                     varchar            [not null]
