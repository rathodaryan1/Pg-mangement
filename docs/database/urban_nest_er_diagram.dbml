}

Table VisitorRequest {
  id                         varchar            [pk, not null, note: 'UUID v4 generated']
  residentId                 varchar           
  propertyId                 varchar            [not null]
  visitorName                varchar            [not null]
  visitorMobile              varchar            [not null]
  relation                   varchar            [not null]
  purpose                    varchar            [not null]
  visitDate                  timestamp          [not null]
  expectedEntryTime          varchar            [not null]
  expectedExitTime           varchar           
  status                     VisitorStatus      [not null, default: 'PENDING']
  approvedBy                 varchar           
  qrPassToken                varchar            [unique, not null, note: 'UUID v4 generated']
  checkInTime                timestamp         
  checkOutTime               timestamp         
  createdAt                  timestamp          [not null, default: `now()`]
  updatedAt                  timestamp          [not null]

  indexes {
