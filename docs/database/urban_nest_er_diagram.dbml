// ------------------------------------------------------------------------------
// LOGICAL MODULES / TABLEGROUPS (DBdiagram.io Grouping)
// ------------------------------------------------------------------------------

TableGroup saas_tenant_billing {
  Tenant
  Plan
}

TableGroup user_auth {
  User
}

TableGroup property_hierarchy {
  Property
  Building
  Floor
  Room
  Bed
}

TableGroup resident_lifecycle {
  Resident
  Agreement
  SecurityDeposit
