# ==============================================================================
# URBAN NEST — FRONTEND (VERCEL / VITE) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Production Backend Express API URL (e.g. https://your-backend.onrender.com/api)
# For local dev: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Public Razorpay Key ID (Client-side checkout dialog)
# Safe to expose publicly on the frontend. Never expose Key Secret.
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
